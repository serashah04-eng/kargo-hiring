# Neon Postgres connection string (Neon console → Connect → "Connection string")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Resend (https://resend.com/api-keys). With onboarding@resend.dev you can only send to your own Resend account email
# until you verify a domain.
RESEND_API_KEY=
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>
EMAIL_REPLY_TO=

# true = record emails as sent without calling Resend (for local testing only)
EMAIL_DRY_RUN=false

# Password for the whole app (any username). Required in production.
APP_PASSWORD=
